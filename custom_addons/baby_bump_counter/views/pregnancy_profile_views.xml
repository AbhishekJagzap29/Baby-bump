<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_baby_pregnancy_profile_list" model="ir.ui.view">
        <field name="name">baby.pregnancy.profile.list</field>
        <field name="model">baby.pregnancy.profile</field>
        <field name="arch" type="xml">
            <tree string="Pregnancy Profiles">
                <field name="name"/>
                <field name="email"/>
                <field name="mobile"/>
                <field name="lmp_date"/>
                <field name="due_date"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_baby_pregnancy_profile_form" model="ir.ui.view">
        <field name="name">baby.pregnancy.profile.form</field>
        <field name="model">baby.pregnancy.profile</field>
        <field name="arch" type="xml">
            <form string="Pregnancy Profile">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Full Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Jane Doe"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contact Details">
                            <field name="email" placeholder="e.g. jane@example.com"/>
                            <field name="mobile" placeholder="e.g. +1 555-0199"/>
                        </group>
                        <group string="Pregnancy Details">
                            <field name="lmp_date"/>
                            <field name="due_date"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_baby_pregnancy_profile" model="ir.actions.act_window">
        <field name="name">Pregnancy Profiles</field>
        <field name="res_model">baby.pregnancy.profile</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
