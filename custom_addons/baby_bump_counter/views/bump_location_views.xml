<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_baby_bump_location_tree" model="ir.ui.view">
        <field name="name">baby.bump.location.tree</field>
        <field name="model">baby.bump.location</field>
        <field name="arch" type="xml">
            <tree string="Bump Locations" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_baby_bump_location" model="ir.actions.act_window">
        <field name="name">Bump Locations</field>
        <field name="res_model">baby.bump.location</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new baby bump location!
            </p>
        </field>
    </record>

</odoo>
